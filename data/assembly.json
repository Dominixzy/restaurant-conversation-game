    "roll": {
      "base": "rice_on_nori",
      "fillings": {
        "salmon": "roll_salmon",
        "avocado": "roll_veg",
        "cucumber": "roll_veg"
      },
      "game": {
        "type": "hold",
        "seconds": 1.2,
        "prompt": "Hold to roll it up tight"
      }
    },
    "stretch": {
      "map": {
        "dough": "dough_flat"
      },
      "game": {
        "type": "hold",
        "seconds": 1.4,
        "prompt": "Hold to stretch the dough"
      }
    },
    "boil": {
      "map": {
        "spaghetti": "pasta_cooked"
      },
      "game": {
        "type": "timing",
        "seconds": 3.2,
        "prompt": "Boil the pasta",
        "stop": "Drain it!",
        "zones": [
          {
            "to": 50,
            "label": "Hard",
            "quality": "under"
          },
          {
            "to": 78,
            "label": "Al dente",
            "quality": "perfect"
          },
          {
            "to": 100,
            "label": "Soggy",
            "quality": "over"
          }
        ]
      }
    },
    "bake": {
      "base": "pizza_sauced",
      "fillings": {
        "mushroom": "pizza_funghi",
        "mozzarella": "pizza_margherita"
      },
      "game": {
        "type": "timing",
        "seconds": 3,
        "prompt": "Bake the pizza",
        "stop": "Take it out!",
        "zones": [
          {
            "to": 52,
            "label": "Raw",
            "quality": "under"
          },
          {
            "to": 80,
            "label": "Golden",
            "quality": "perfect"
          },
          {
            "to": 100,
            "label": "Burnt",
            "quality": "over"
          }
        ]
      }
    },
    "pound": {
      "base": "garlic",
      "fillings": {
        "chili_3": "paste_3",
        "chili_2": "paste_2",
        "chili": "paste_1"
      },
      "game": {
        "type": "pound",
        "taps": 10,
        "seconds": 3,
        "prompt": "Tap fast to pound the garlic and chili!"
      }
    },
    "toss": {
      "base": [
        "paste_1",
        "paste_2",
        "paste_3"
      ],
      "fillings": {
        "salted_crab": "som_tam_poo",
        "peanuts": "som_tam_thai",
        "dried_shrimp": "som_tam_thai_no_peanuts"
      },
      "game": {
        "type": "hold",
        "seconds": 1.4,
        "prompt": "Hold to pound and mix everything together"
      }
    },
    "flip": {
      "map": {
        "batter": "pancake"
      },
      "game": {
        "type": "timing",
        "seconds": 3,
        "prompt": "Cook the pancake",
        "stop": "Flip it!",
        "zones": [
          {
            "to": 50,
            "label": "Pale",
            "quality": "under"
          },
          {
            "to": 78,
            "label": "Golden",
            "quality": "perfect"
          },
          {
            "to": 100,
            "label": "Burnt",
            "quality": "over"
          }
        ]
      }
    },
    "grill": {
      "map": {
        "patty_raw": "patty"
      },
      "game": {
        "type": "timing",
        "seconds": 3,
        "prompt": "Grill the patty",
        "stop": "Take it off!",
        "zones": [
          {
            "to": 50,
            "label": "Raw",
            "quality": "under"
          },
          {
            "to": 78,
            "label": "Juicy",
            "quality": "perfect"
          },
          {
            "to": 100,
            "label": "Burnt",
            "quality": "over"
          }
        ]
      }
    },
    "fry": {
      "map": {
        "potato_sticks": "fries"
      },
      "game": {
        "type": "timing",
        "seconds": 3,
        "prompt": "Fry the potatoes",
        "stop": "Lift the basket!",
        "zones": [
          {
            "to": 50,
            "label": "Pale",
            "quality": "under"
          },
          {
            "to": 78,
            "label": "Crispy",
            "quality": "perfect"
          },
          {
            "to": 100,
            "label": "Burnt",
            "quality": "over"
          }
        ]
      }
    },
    "cut": {
      "map": {
        "roll_salmon": "cut_salmon",
        "roll_veg": "cut_veg",
        "pizza_margherita": "pizza_margherita_cut",
        "pizza_funghi": "pizza_funghi_cut",
        "potato": "potato_sticks"
      },
      "game": {
        "type": "slice",
        "marks": 3,
        "prompt": "Tap when the knife is over each mark"
      }
